# Copy to .env and change before showing the project to anyone else.
# Every password below is only used inside the Docker network.

# Customer Service seeds this administrator account on first start.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

# RabbitMQ: management/admin user and the restricted application user.
RABBITMQ_ADMIN_USER=rf_admin
RABBITMQ_ADMIN_PASSWORD=change-me-rabbit-admin
RABBITMQ_APP_USER=rf_app
RABBITMQ_APP_PASSWORD=change-me-rabbit-app

# One credential set per database (database-per-service).
POSTGRES_PASSWORD=change-me-product-db
MONGO_PASSWORD=change-me-customer-db
MYSQL_ROOT_PASSWORD=change-me-mysql-root
MYSQL_ORDER_PASSWORD=change-me-order-db
MYSQL_DEBEZIUM_PASSWORD=change-me-debezium
REDIS_PASSWORD=change-me-notification-db

GRAFANA_ADMIN_PASSWORD=change-me-grafana
